{
  "name": "agent-berserk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Claude Code mod: /berserk burns leftover quota before the reset.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "claude plugin validate .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:plugin && npm run validate",
    "test:plugin": "claude plugin test .",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@microsoft/copilot-sdk": "2.0.1"
  }
}
